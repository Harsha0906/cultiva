  "fixed_sql": [
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"plot\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"target_minutes\" INTEGER NULL, \"repeat_mask\" INTEGER NOT NULL DEFAULT 0, \"crop\" TEXT NOT NULL, \"slot\" INTEGER NOT NULL, \"created_day\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"archived_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "completions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"completions\" (\"id\" TEXT NOT NULL, \"task_id\" TEXT NOT NULL REFERENCES tasks (id), \"day\" TEXT NOT NULL, \"method\" TEXT NOT NULL, \"minutes\" INTEGER NOT NULL DEFAULT 0, \"ripened_at\" INTEGER NOT NULL, \"harvested_at\" INTEGER NULL, \"coins\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"), UNIQUE (\"task_id\", \"day\"));"
        }
      ]
    },
    {
      "name": "focus_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"focus_sessions\" (\"id\" TEXT NOT NULL, \"task_id\" TEXT NOT NULL REFERENCES tasks (id), \"day\" TEXT NOT NULL, \"started_at\" INTEGER NOT NULL, \"planned_sec\" INTEGER NOT NULL, \"accumulated_sec\" INTEGER NOT NULL DEFAULT 0, \"status\" TEXT NOT NULL, \"suspicious\" INTEGER NOT NULL DEFAULT 0 CHECK (\"suspicious\" IN (0, 1)), \"ended_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "journal",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"journal\" (\"day\" TEXT NOT NULL, \"mood\" INTEGER NULL, \"note\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"day\"));"
        }
      ]
    },
    {
      "name": "inventory",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"inventory\" (\"item_id\" TEXT NOT NULL, \"qty\" INTEGER NOT NULL DEFAULT 1, \"placed_spot\" INTEGER NULL, PRIMARY KEY (\"item_id\"));"
        }
      ]
    },
    {
      "name": "coin_ledger",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"coin_ledger\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"delta\" INTEGER NOT NULL, \"reason\" TEXT NOT NULL, \"ref_id\" TEXT NULL, \"day\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "completions_day",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX completions_day ON completions (day)"
        }
      ]
    },
    {
      "name": "focus_task_day",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX focus_task_day ON focus_sessions (task_id, day)"
        }
      ]
    },
    {
      "name": "ledger_day",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX ledger_day ON coin_ledger (day)"
        }
      ]
    }
